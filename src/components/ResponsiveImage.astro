---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  image?: ImageMetadata;
  imageUrl?: string;
  alt: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes: string;
  formats?: ("avif" | "webp")[];
  quality?: number;
  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";
  fetchpriority?: "high" | "low" | "auto";
};

const {
  image,
  imageUrl,
  alt,
  width,
  height,
  widths = [480, 768, 1120, 1440],
  sizes,
  formats = ["avif", "webp"],
  quality = 70,
  loading = "lazy",
  decoding = "async",
  fetchpriority
} = Astro.props;
---

{
  image ? (
    <Picture
      src={image}
      alt={alt}
      formats={formats}
      widths={widths}
      width={width ?? widths[widths.length - 1]}
      sizes={sizes}
      quality={quality}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
    />
  ) : (
    imageUrl && (
      <img
        src={imageUrl}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
      />
    )
  )
}
