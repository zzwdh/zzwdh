---
import type { ImageMetadata } from "astro";
import ResponsiveImage from "@components/ResponsiveImage.astro";

type Props = {
  eyebrow: string;
  name: string;
  role: string;
  copy: string;
  image?: ImageMetadata;
  imageUrl?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt: string;
};

const { eyebrow, name, role, copy, image, imageUrl, imageWidth, imageHeight, imageAlt } = Astro.props;
---

<section class="hero" aria-label="首屏介绍">
  <div class="hero-media" data-art data-label="HERO">
    <ResponsiveImage
      image={image}
      imageUrl={imageUrl}
      alt={imageAlt}
      widths={[960, 1440, 1920, 2560]}
      width={imageWidth ?? 2560}
      height={imageHeight}
      sizes="100vw"
      quality={78}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <div class="hero-shade"></div>
  <div class="hero-content">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{name}</h1>
    <p class="hero-role">{role}</p>
    <p class="hero-copy">{copy}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#works">看作品</a>
      <a class="button button-ghost" href="#contact">联系我</a>
    </div>
  </div>
  <div class="hero-meta" aria-label="作品集信息">
    <span>Personal Archive</span>
    <span>Selected Works</span>
    <span>2026</span>
  </div>
  <a class="scroll-cue" href="#works" aria-label="向下浏览">
    <span></span>
  </a>
</section>
