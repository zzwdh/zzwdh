---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  eyebrow: string;
  name: string;
  role: string;
  copy: string;
  image: ImageMetadata;
  imageAlt: string;
};

const { eyebrow, name, role, copy, image, imageAlt } = Astro.props;
---

<section class="hero" aria-label="首屏介绍">
  <div class="hero-media" data-art data-label="HERO">
    <Picture
      src={image}
      alt={imageAlt}
      formats={["avif", "webp"]}
      widths={[960, 1440, 1920, 2560]}
      width={2560}
      sizes="100vw"
      quality={78}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <div class="hero-shade"></div>
  <div class="hero-content">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{name}</h1>
    <p class="hero-role">{role}</p>
    <p class="hero-copy">{copy}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#works">看作品</a>
      <a class="button button-ghost" href="#contact">联系我</a>
    </div>
  </div>
  <a class="scroll-cue" href="#works" aria-label="向下浏览">
    <span></span>
  </a>
</section>
