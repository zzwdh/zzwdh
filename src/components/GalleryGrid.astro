---
import { getImage } from "astro:assets";
import ResponsiveImage from "@components/ResponsiveImage.astro";
import type { WorkItem } from "@data/site";

type Props = {
  id: string;
  kicker: string;
  title: string;
  copy: string;
  items: WorkItem[];
  sectionClass?: string;
  actionHref?: string;
  actionLabel?: string;
};

const { id, kicker, title, copy, items, sectionClass = "", actionHref, actionLabel } = Astro.props;

const categoryLabels = {
  photography: "照片",
  drone: "航拍",
  video: "视频",
  panorama: "全景"
};

const enhancedItems = await Promise.all(
  items.map(async (item) => ({
    item,
    fullSrc: item.image
      ? (await getImage({ src: item.image, width: 1920, format: "webp", quality: 82 })).src
      : item.imageUrl
  }))
);
---

<section id={id} class:list={["section work-section", sectionClass]}>
  <div class="section-heading">
    <div>
      <p class="section-kicker">{kicker}</p>
      <h2>{title}</h2>
    </div>
    <div class="section-heading-copy">
      <p>{copy}</p>
      {actionHref && actionLabel && <a class="section-action" href={actionHref}>{actionLabel}</a>}
    </div>
  </div>

  <div class="gallery-grid" data-gallery={id}>
    {
      enhancedItems.map(({ item, fullSrc }) => {
        const hasImage = Boolean(item.image || item.imageUrl);
        return (
          <button
            class:list={[
              "gallery-item",
              item.layout === "wide" && "gallery-item-wide",
              item.layout === "tall" && "gallery-item-tall",
              !hasImage && "is-missing"
            ]}
            data-art
            data-label={item.label}
            data-placeholder={item.placeholder ?? "待补作品"}
            data-caption={item.title}
            data-description={item.description}
            data-story-url={item.storyStatus === "ready" ? `/works/${item.slug}/` : undefined}
            data-story-status={item.storyStatus}
            data-full-src={fullSrc}
            type="button"
            disabled={!hasImage}
            aria-label={hasImage ? `预览${item.title}` : item.placeholder ?? item.title}
          >
            {
              hasImage && (
                <ResponsiveImage
                  image={item.image}
                  imageUrl={item.imageUrl}
                  alt={item.alt}
                  widths={[480, 768, 1120, 1440]}
                  width={1440}
                  height={item.imageHeight}
                  sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw"
                  quality={70}
                  loading="lazy"
                  decoding="async"
                />
              )
            }
            <span class="gallery-title">{item.title}</span>
            <span class="gallery-category">{categoryLabels[item.category]}</span>
          </button>
        );
      })
    }
  </div>
</section>
