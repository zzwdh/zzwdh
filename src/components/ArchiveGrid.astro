---
import { Picture } from "astro:assets";
import type { WorkItem } from "@data/site";

type Props = {
  items: WorkItem[];
};

const { items } = Astro.props;

const categoryLabels = {
  photography: "照片",
  drone: "航拍"
};
---

<div class="archive-grid" aria-label="作品档案">
  {
    items.map((item) => (
      <a class="archive-card" href={`/works/${item.slug}/`} aria-label={`查看${item.title}`}>
        {
          item.image && (
            <Picture
              src={item.image}
              alt={item.alt}
              formats={["avif", "webp"]}
              widths={[480, 768, 1120, 1440]}
              width={1440}
              sizes="(max-width: 560px) 100vw, (max-width: 960px) 50vw, 33vw"
              quality={70}
              loading="lazy"
              decoding="async"
            />
          )
        }
        <div class="archive-card-copy">
          <span>{categoryLabels[item.category]}</span>
          <h2>{item.title}</h2>
          <p>{item.description}</p>
        </div>
      </a>
    ))
  }
</div>
