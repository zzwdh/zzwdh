---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import Hero from "@components/Hero.astro";
import About from "@components/About.astro";
import GalleryGrid from "@components/GalleryGrid.astro";
import VideoSection from "@components/VideoSection.astro";
import PanoramaSection from "@components/PanoramaSection.astro";
import ContactSection from "@components/ContactSection.astro";
import Lightbox from "@components/Lightbox.astro";
import { getFeaturedWorks, getPanoramas, getSite, getVideos } from "@data/site";
import { homeNavItems } from "@data/navigation";

const site = await getSite();
const featuredWorks = await getFeaturedWorks();
const videos = await getVideos();
const panoramas = await getPanoramas();

---

<BaseLayout title={site.title} description="邹羽轩个人影像作品集，收集摄影、个人视频与360度全景作品。">
  <SiteHeader title={site.navTitle} items={homeNavItems} />
  <main id="top">
    <Hero
      eyebrow={site.eyebrow}
      name={site.name}
      role={site.role}
      copy={site.heroCopy}
      image={site.heroImage}
      imageUrl={site.heroImageUrl}
      imageWidth={site.heroImageWidth}
      imageHeight={site.heroImageHeight}
      imageAlt={site.heroAlt}
    />
    <GalleryGrid
      id="works"
      kicker="SELECTED WORKS"
      title="作品集"
      copy="首页只留第一眼。更多照片，收在档案馆里慢慢看。"
      items={featuredWorks}
      sectionClass="featured-work-section"
      actionHref="/archive/"
      actionLabel="进入档案馆"
    />
    <VideoSection items={videos} />
    <PanoramaSection panoramas={panoramas} />
    <About title={site.aboutTitle} copy={site.aboutCopy} />
    <ContactSection
      email={site.email}
      wechat={site.wechat}
      socials={site.socials}
      qr={site.wechatQr}
      qrUrl={site.wechatQrUrl}
    />
  </main>
  <Lightbox />
  <script>
    import "@scripts/gallery";
    import "@scripts/panorama";
  </script>
</BaseLayout>
